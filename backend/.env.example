# ── Servidor ─────────────────────────────────────────────
PORT=3001

# URL del frontend (para CORS y para los links del boleto digital)
FRONTEND_URL=http://localhost:8000

# ── Google Sheets ─────────────────────────────────────────
# ID del spreadsheet (la hoja de eventos actual)
SPREADSHEET_ID=12L1OaLFvxlUw4ecKKxsQgHicb5x6jn5GfS4jxFhhcmk

# Nombre EXACTO de la pestaña (tab) donde se guardan los registros
SHEET_NAME=SORTEO TOTAL FENAPO2026

# Ruta al JSON de la cuenta de servicio de Google Cloud.
# Deja vacío para modo demo (no escribe en el sheet, solo simula).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── WhatsApp (Baileys) ────────────────────────────────────
# Número que usa Baileys para enviar (opcional, informativo).
WHATSAPP_NUMBER=

# true  = si no hay sesión de WhatsApp, imprime el mensaje en consola
#         y acepta el código OTP de prueba 000000 (para desarrollar).
# false = requiere sesión de WhatsApp real conectada.
DRY_RUN=true

# ── Sorteo ────────────────────────────────────────────────
# Premio y fecha del sorteo (se muestran en el boleto y countdown).
# Déjalos vacíos / "a definir" hasta que los tengas.
PREMIO=A definir
FECHA_SORTEO=

# ── Seguridad (opcional) ──────────────────────────────────
# Secreto para el webhook opcional que llaman desde Apps Script.
WEBHOOK_SECRET=

# Logs de Baileys: trace|debug|info|warn|error|fatal|silent
BAILEYS_LOG_LEVEL=silent
